{
  "name": "@portrait-studio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --conditions=react-server --import tsx worker/main.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "stats:reset": "node --conditions=react-server --import tsx scripts/stats-reset.ts",
    "leads:export": "node --conditions=react-server --import tsx scripts/leads-export.ts",
    "setup:twilio": "node --conditions=react-server --import tsx scripts/setup-twilio.ts",
    "eval:top-clearance": "node --conditions=react-server --import tsx evals/top-clearance.eval.ts",
    "eval:frame-safe-zone": "node --import tsx evals/frame-safe-zone.eval.ts",
    "previews:styles": "node --conditions=react-server --import tsx scripts/style-previews.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.2",
    "openai": "^7.40.0",
    "pino": "^10",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "twilio": "^6.2.0",
    "twilio-sync": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
