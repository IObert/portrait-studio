# Portrait Studio configuration. Copy to .env.local and fill in. Never commit .env.local.
# Used by `pnpm dev`, the worker, scripts, `docker compose` / `podman compose` and ./deploy.sh.
# README.md explains where to find each value.

# --- App ---------------------------------------------------------------------
# Public HTTPS origin: webhooks, share links, Twilio signature validation.
# Locally: your tunnel URL (e.g. https://abc123.ngrok.app). Azure: printed by ./deploy.sh.
PUBLIC_BASE_URL=
# Basic auth for /admin and /booth. Choose a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Twilio ------------------------------------------------------------------
# Console > Account info.
TWILIO_ACCOUNT_SID=
# Console > Account info. Used only to validate webhook signatures.
TWILIO_AUTH_TOKEN=
# Console > API keys & tokens > Create API key (Standard). Used for REST and Sync tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Messaging > Services. The service holding all SMS and WhatsApp senders (MG...).
TWILIO_MESSAGING_SERVICE_SID=
# Printed by `pnpm --filter web setup:twilio` (IS...).
TWILIO_SYNC_SERVICE_SID=
# Printed by `pnpm --filter web setup:twilio` (VA...). Needs the SendGrid email integration.
TWILIO_VERIFY_SERVICE_SID=
# Printed by `pnpm --filter web setup:twilio` (mem_store_...).
TWILIO_MEMORY_STORE_ID=
# Approved WhatsApp "delivery" templates (HX...), printed by setup:twilio.
TWILIO_TEMPLATE_DELIVERY_EN=
TWILIO_TEMPLATE_DELIVERY_PT_BR=

# --- OpenAI ------------------------------------------------------------------
# platform.openai.com > API keys.
OPENAI_API_KEY=
# One image model, never switched at runtime (docs/decisions.md D-01).
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_VISION_MODEL=gpt-6.1-sol
OPENAI_CHAT_MODEL=gpt-6-luna

# --- Azure Blob Storage ------------------------------------------------------
# Local compose uses Azurite automatically when this is empty.
# Azure: Storage account > Access keys > Connection string (./deploy.sh creates one if empty).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=portrait-studio

# --- Deployment (./deploy.sh only, all optional) ----------------------------
# AZURE_LOCATION=northeurope
# AZURE_RESOURCE_GROUP=rg-portrait-studio
# AZURE_APP_NAME=portrait-studio
# AZURE_ACR_NAME=portraitstudioacr
# AZURE_STORAGE_ACCOUNT=portraitstudioblob
# WEB_MIN_REPLICAS=1
# WEB_MAX_REPLICAS=3
# WORKER_REPLICAS=1
# Set if your Azure policy requires a created_by tag different from your az login.
# AZURE_USER=you@example.com
