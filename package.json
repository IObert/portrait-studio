{
  "name": "portrait-studio",
  "private": true,
  "description": "Portrait Studio: an AI photo booth for events",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @portrait-studio/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @portrait-studio/web test:e2e"
  }
}
